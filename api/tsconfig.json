{
      "extends": "../tsconfig.json",
      "compilerOptions": {
            "module": "commonjs",
            "target": "ES2022",
            "lib": [
                  "ES2022"
            ],
            "types": [
                  "node"
            ],
            "moduleResolution": "node",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "skipLibCheck": true,
            "noEmit": true
      },
      "include": [
            "api/**/*"
      ]
}