{
  "name": "react-portfolio",
  "version": "1.0.0",
  "description": "A professional portfolio application built with React.",
  "main": "index.tsx",
  "scripts": {
    "test:e2e": "playwright test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
